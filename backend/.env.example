# JalWatch Environment Configuration
# Copy this file to .env and fill in your values

# Database: default is SQLite (no setup needed)
# For PostgreSQL: DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/jalwatch
DATABASE_URL=sqlite:///./jalwatch.db

# Required before API data and operations are available.
JALWATCH_ADMIN_PASSWORD=
JALWATCH_SESSION_SECRET=
# Set true behind HTTPS in a deployed environment.
JALWATCH_COOKIE_SECURE=false
# Comma-separated frontend origins when deployed.
# JALWATCH_CORS_ORIGINS=https://jalwatch.example.org
